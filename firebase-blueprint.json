{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Information collected from high-ticket strategy intake form.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "projectDescription": { "type": "string" },
        "budget": { "type": "string" },
        "chosenStack": { "type": "string" },
        "selectedTags": { "type": "array" },
        "dateTime": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "status", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Client CSAT review rating and feedback.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "companyProject": { "type": "string" },
        "email": { "type": "string" },
        "rating": { "type": "integer" },
        "feedback": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "clientName", "companyProject", "email", "rating", "feedback", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Log of actions performed in the application for administration monitoring.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "action", "timestamp"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collected strategy intake requests."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Client CSAT reviews and rating submissions."
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit trail logs for administrative control viewport tracking."
    }
  }
}
